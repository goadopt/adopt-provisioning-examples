{
  "name": "@adopt-tech/provisioning",
  "version": "1.0.5",
  "description": "Type-safe JS toolkit for creating and managing Adopt entities, configurations, and subscriptions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "cli": "ts-node src/cli.ts",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:live": "jest --selectProjects live",
    "lint": "eslint 'src/**/*.ts'",
    "format": "eslint 'src/**/*.ts' --fix",
    "format:check": "prettier --check 'src/**/*.ts'",
    "prepare": "husky"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/yargs": "^17.0.32",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "ora": "^5.4.1",
    "yargs": "^17.7.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "commitlint": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^0.25.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.0",
    "semantic-release": "^24.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "adopt",
    "goadopt",
    "provisioning",
    "compliance",
    "cookies",
    "lgpd",
    "gdpr"
  ],
  "author": "AdOpt <dev@goadopt.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
